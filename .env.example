# ============================================================================
#  GOLDEN EYE PRODS. — Variáveis de ambiente
#  Copie para .env.local (desenvolvimento) e cadastre na Vercel (produção).
#  NUNCA comite o .env.local. Ele já está no .gitignore.
# ============================================================================

# --- Banco de dados -----------------------------------------------------------
# Supabase: Project Settings > Database > Connection string > "Transaction pooler"
# IMPORTANTE: use a porta 6543 (pooler), não a 5432, senão a Vercel esgota conexões.
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# --- Mercado Pago -------------------------------------------------------------
# https://www.mercadopago.com.br/developers/panel > Suas integrações > sua app
# Comece com as credenciais de TESTE. Só troque para produção depois do checklist.
MP_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxx"
# Painel do MP > sua app > Webhooks > "Assinatura secreta". Sem isso qualquer um
# pode fingir que um pagamento foi aprovado.
MP_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"

# --- Assinatura dos ingressos -------------------------------------------------
# Segredo que assina o QR Code. Gere com:  openssl rand -hex 32
# Se vazar, é possível forjar ingressos. Trate como senha de banco.
TICKET_HMAC_SECRET="troque-isto-por-64-caracteres-hexadecimais-aleatorios"

# --- Sessão do app de portaria ------------------------------------------------
# Gere outro diferente:  openssl rand -hex 32
PORTARIA_JWT_SECRET="troque-isto-tambem-por-algo-aleatorio"

# --- E-mail (Resend) ----------------------------------------------------------
# https://resend.com > API Keys. Verifique seu domínio antes de mandar de verdade.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_REMETENTE="Golden Eye Prods. <ingressos@SEUDOMINIO.com.br>"

# --- Cron da Vercel -----------------------------------------------------------
# Protege /api/cron/expirar. Gere com: openssl rand -hex 16
CRON_SECRET="xxxxxxxxxxxx"

# --- URL pública --------------------------------------------------------------
# Em produção: https://goldeneyeprods.com.br  (ou a URL .vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
